{% extends 'base.html.twig' %}

{% block title %}Photos — {{ evenement.nom }} — Comapik{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="page page--large">
        <div class="entete-section">
            <h1>{{ evenement.nom }}</h1>
            <a class="bouton bouton--secondaire bouton--petit" href="{{ path('admin_accueil') }}">← Événements</a>
        </div>

        {% include '_flashes.html.twig' %}

        <div class="carte">
            <form method="post" enctype="multipart/form-data">
                <div class="champ">
                    <label for="photos">Ajouter des photos (JPEG ou PNG)</label>
                    <input type="file" id="photos" name="photos[]" accept="image/jpeg,image/png" multiple required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button type="submit">Importer</button>
            </form>
        </div>

        <h2>Photos du photographe</h2>
        {% include 'admin/evenement/_grille_photos.html.twig' with {
            photos: photosPhotographe,
            vide: "Aucune photo pour l'instant. Ajoute les premières ci-dessus.",
        } %}

        {% if evenement.uploadClientAutorise or photosClients is not empty %}
            <h2>Photos ajoutées par les clients</h2>
            {% include 'admin/evenement/_grille_photos.html.twig' with {
                photos: photosClients,
                vide: 'Aucune photo ajoutée par un client pour l\'instant.',
            } %}
        {% endif %}
    </div>

    {% include '_visionneuse.html.twig' %}
{% endblock %}
