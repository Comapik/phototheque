{% extends 'base.html.twig' %}

{% block title %}Photos — {{ evenement.nom }} — Comapik{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="page page--large">
        <div class="entete-section">
            <h1>{{ evenement.nom }}</h1>
            <a class="bouton bouton--secondaire bouton--petit" href="{{ path('admin_accueil') }}">← Événements</a>
        </div>

        {% include '_flashes.html.twig' %}

        <div class="carte">
            <form method="post" enctype="multipart/form-data" data-turbo="false" data-controller="redimensionnement" data-action="submit->redimensionnement#soumettre">
                <div class="champ">
                    <label for="photos">Ajouter des photos (JPEG ou PNG)</label>
                    <input type="file" id="photos" name="photos[]" accept="image/jpeg,image/png" multiple required data-redimensionnement-target="fichier">
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button type="submit">Importer</button>
            </form>
        </div>

        <form method="post" action="{{ path('admin_photos_suppression_groupee', { id: evenement.id }) }}" data-turbo="false">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('suppression_groupee') }}">

            {% if photosPhotographe is not empty or photosClients is not empty %}
                <p>
                    <button type="submit" class="bouton--danger bouton--petit" onclick="return confirm('Supprimer les photos sélectionnées ?')">
                        Supprimer la sélection
                    </button>
                </p>
            {% endif %}

            <h2>Photos du photographe</h2>
            {% include 'admin/evenement/_grille_photos.html.twig' with {
                photos: photosPhotographe,
                vide: "Aucune photo pour l'instant. Ajoute les premières ci-dessus.",
            } %}

            {% if evenement.uploadClientAutorise or photosClients is not empty %}
                <h2>Photos ajoutées par les clients</h2>
                {% include 'admin/evenement/_grille_photos.html.twig' with {
                    photos: photosClients,
                    vide: 'Aucune photo ajoutée par un client pour l\'instant.',
                } %}
            {% endif %}
        </form>
    </div>

    {% include '_visionneuse.html.twig' %}
{% endblock %}
