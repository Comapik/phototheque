{% extends 'base.html.twig' %}

{% block title %}Photos — {{ evenement.nom }} — Comapik{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="page page--large">
        <div class="entete-section">
            <h1>{{ evenement.nom }}</h1>
            <a class="bouton bouton--secondaire bouton--petit" href="{{ path('admin_accueil') }}">← Événements</a>
        </div>

        {% include '_flashes.html.twig' %}

        <div class="carte">
            <form method="post" enctype="multipart/form-data">
                <div class="champ">
                    <label for="photos">Ajouter des photos (JPEG ou PNG)</label>
                    <input type="file" id="photos" name="photos[]" accept="image/jpeg,image/png" multiple required>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('submit') }}">
                <button type="submit">Importer</button>
            </form>
        </div>

        {% if photos is empty %}
            <p class="etat-vide">Aucune photo pour l'instant. Ajoute les premières ci-dessus.</p>
        {% else %}
            <ul class="grille-photos">
                {% for photo in photos %}
                    <li>
                        <figure>
                            <button type="button" class="photo-vignette" data-visionneuse
                                    data-src="{{ path('admin_photo_apercu', { id: photo.id }) }}"
                                    data-nom="{{ photo.nomOriginal }}">
                                <img src="{{ path('admin_photo_miniature', { id: photo.id }) }}" alt="{{ photo.nomOriginal }}" loading="lazy">
                            </button>
                            <figcaption>
                                <div class="ligne">
                                    <span class="nom-fichier">{{ photo.nomOriginal }}</span>
                                    <form method="post" action="{{ path('admin_photo_suppression', { id: photo.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('suppression' ~ photo.id) }}">
                                        <button type="submit" class="bouton--danger bouton--petit" onclick="return confirm('Supprimer cette photo ?')">Suppr.</button>
                                    </form>
                                </div>
                            </figcaption>
                        </figure>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    {% include '_visionneuse.html.twig' %}
{% endblock %}
