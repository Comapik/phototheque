{% extends 'base.html.twig' %}

{% block title %}Événements{% endblock %}

{% block body %}
    <div class="page">
        <h1>Événements</h1>

        {% for message in app.flashes('success') %}
            <p>{{ message }}</p>
        {% endfor %}

        <p><a class="bouton" href="{{ path('admin_evenement_nouveau') }}">+ Nouvel événement</a></p>

        <table>
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Date</th>
                    <th>Photos</th>
                    <th>Clients</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for evenement in evenements %}
                    <tr>
                        <td>{{ evenement.nom }}</td>
                        <td>{{ evenement.date|date('d/m/Y') }}</td>
                        <td>{{ evenement.photos|length }}</td>
                        <td>{{ evenement.clients|map(c => c.nom)|join(', ') }}</td>
                        <td>
                            <a href="{{ path('admin_evenement_photos', { id: evenement.id }) }}">Photos</a>
                            <a href="{{ path('admin_evenement_edition', { id: evenement.id }) }}">Modifier</a>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5">Aucun événement pour l'instant.</td></tr>
                {% endfor %}
            </tbody>
        </table>

        <p><a href="{{ path('admin_clients') }}">Clients</a> · <a href="{{ path('admin_deconnexion') }}">Se déconnecter</a></p>
    </div>
{% endblock %}
