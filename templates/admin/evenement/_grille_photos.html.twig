{% if photos is empty %}
    <p class="etat-vide">{{ vide }}</p>
{% else %}
    <ul class="grille-photos">
        {% for photo in photos %}
            <li>
                <figure>
                    <label class="case-selection">
                        <input type="checkbox" name="photos[]" value="{{ photo.id }}">
                    </label>
                    <button type="button" class="photo-vignette" data-visionneuse
                            data-src="{{ path('admin_photo_apercu', { id: photo.id }) }}"
                            data-nom="{{ photo.nomOriginal }}">
                        <img src="{{ path('admin_photo_miniature', { id: photo.id }) }}" alt="{{ photo.nomOriginal }}" loading="lazy">
                    </button>
                    <figcaption>
                        <span class="nom-fichier">{{ photo.nomOriginal }}</span>
                        {% if photo.prenomUploadeur %}
                            <span class="etiquette-auteur">Ajoutée par {{ photo.prenomUploadeur }}</span>
                        {% endif %}
                    </figcaption>
                </figure>
            </li>
        {% endfor %}
    </ul>
{% endif %}
