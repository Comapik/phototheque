{% extends 'base.html.twig' %}

{% block title %}{{ evenement.id ? 'Modifier' : 'Nouvel' }} événement{% endblock %}

{% block body %}
    <div class="page">
        <h1>{{ evenement.id ? 'Modifier' : 'Nouvel' }} événement</h1>

        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.date) }}
            {{ form_row(form.description) }}
            {{ form_row(form.slug) }}

            <div>
                <label>{{ form.clients.vars.label }}</label>
                <div class="checkbox-list">
                    {% for choix in form.clients %}
                        <label>{{ form_widget(choix) }} {{ choix.vars.label }}</label>
                    {% else %}
                        <p>Aucun client n'existe encore. <a href="{{ path('admin_client_nouveau') }}">En créer un</a>.</p>
                    {% endfor %}
                </div>
            </div>

            <button type="submit">Enregistrer</button>
        {{ form_end(form) }}

        <p><a href="{{ path('admin_evenements') }}">Retour à la liste</a></p>
    </div>
{% endblock %}
