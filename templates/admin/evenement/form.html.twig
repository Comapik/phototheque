{% extends 'base.html.twig' %}

{% block title %}Nouvel événement{% endblock %}

{% block body %}
    <div class="page">
        <h1>Nouvel événement</h1>

        {{ form_start(form) }}
            {{ form_row(form.nom) }}
            {{ form_row(form.date) }}
            {{ form_row(form.description) }}
            {{ form_row(form.slug) }}

            <button type="submit">Enregistrer</button>
        {{ form_end(form) }}

        <p><a href="{{ path('admin_evenements') }}">Retour à la liste</a></p>
    </div>
{% endblock %}
