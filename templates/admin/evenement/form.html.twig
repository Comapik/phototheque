{% extends 'base.html.twig' %}

{% block title %}{{ evenement.id ? 'Modifier' : 'Nouvel' }} événement — Comapik{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="page">
        <h1>{{ evenement.id ? 'Modifier' : 'Nouvel' }} événement</h1>

        <div class="carte">
            {{ form_start(form) }}
                {{ form_row(form.nom) }}
                {{ form_row(form.date) }}
                {{ form_row(form.description) }}
                {{ form_row(form.slug) }}
                {{ form_row(form.uploadClientAutorise) }}

                <div class="champ">
                    <label>{{ form.clients.vars.label }}</label>
                    <div class="checkbox-list">
                        {% for choix in form.clients %}
                            <label>{{ form_widget(choix) }} {{ choix.vars.label }}</label>
                        {% else %}
                            <p class="vide">Aucun client n'existe encore. <a href="{{ path('admin_client_nouveau') }}">En créer un</a>.</p>
                        {% endfor %}
                    </div>
                </div>

                <button type="submit" class="bouton--pleine-largeur">Enregistrer</button>
            {{ form_end(form) }}
        </div>

        <p><a class="bouton bouton--secondaire" href="{{ path('admin_accueil') }}">← Retour à la liste</a></p>
    </div>
{% endblock %}
