{% extends 'base.html.twig' %}

{% block title %}Admin — Comapik{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="page page--large">
        {% include '_flashes.html.twig' %}

        <div class="grille-formulaires">
            <section class="carte">
                <h2>Nouvel événement</h2>
                {{ form_start(formEvenement, { action: path('admin_evenement_nouveau') }) }}
                    {{ form_row(formEvenement.nom) }}
                    {{ form_row(formEvenement.date) }}
                    {{ form_row(formEvenement.description) }}
                    {{ form_row(formEvenement.slug) }}

                    <div class="champ">
                        <label>{{ formEvenement.clients.vars.label }}</label>
                        <div class="checkbox-list">
                            {% for choix in formEvenement.clients %}
                                <label>{{ form_widget(choix) }} {{ choix.vars.label }}</label>
                            {% else %}
                                <p class="vide">Aucun client pour l'instant.</p>
                            {% endfor %}
                        </div>
                    </div>

                    <button type="submit" class="bouton--pleine-largeur">Créer l'événement</button>
                {{ form_end(formEvenement) }}
            </section>

            <section class="carte">
                <h2>Nouveau client</h2>
                {{ form_start(formClient, { action: path('admin_client_nouveau') }) }}
                    {{ form_row(formClient.nom) }}
                    {{ form_row(formClient.codeAcces) }}

                    <div class="champ">
                        <label>{{ formClient.evenements.vars.label }}</label>
                        <div class="checkbox-list">
                            {% for choix in formClient.evenements %}
                                <label>{{ form_widget(choix) }} {{ choix.vars.label }}</label>
                            {% else %}
                                <p class="vide">Aucun événement pour l'instant.</p>
                            {% endfor %}
                        </div>
                    </div>

                    <button type="submit" class="bouton--pleine-largeur">Créer le client</button>
                {{ form_end(formClient) }}
            </section>
        </div>

        <div class="entete-section">
            <h1>Événements</h1>
        </div>

        {% if evenements is empty %}
            <p class="etat-vide">Aucun événement pour l'instant. Crée le premier ci-dessus.</p>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Date</th>
                            <th>Photos</th>
                            <th>Clients</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for evenement in evenements %}
                            <tr>
                                <td>{{ evenement.nom }}</td>
                                <td>{{ evenement.date|date('d/m/Y') }}</td>
                                <td>{{ evenement.photos|length }}</td>
                                <td class="cellule-discrete">{{ evenement.clients|map(c => c.nom)|join(', ') ?: '—' }}</td>
                                <td>
                                    <div class="actions">
                                        <a class="bouton bouton--secondaire bouton--petit" href="{{ path('admin_evenement_photos', { id: evenement.id }) }}">Photos</a>
                                        <a class="bouton bouton--secondaire bouton--petit" href="{{ path('admin_evenement_edition', { id: evenement.id }) }}">Modifier</a>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
