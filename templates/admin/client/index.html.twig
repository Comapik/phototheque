{% extends 'base.html.twig' %}

{% block title %}Clients — Comapik{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="page page--large">
        {% include '_flashes.html.twig' %}

        <div class="entete-section">
            <h1>Clients</h1>
            <a class="bouton" href="{{ path('admin_client_nouveau') }}">+ Nouveau client</a>
        </div>

        {% if clients is empty %}
            <p class="etat-vide">Aucun client pour l'instant.</p>
        {% else %}
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Nom</th>
                            <th>Événements</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for client in clients %}
                            <tr>
                                <td>{{ client.nom }}</td>
                                <td class="cellule-discrete">{{ client.evenements|map(e => e.nom)|join(', ') ?: '—' }}</td>
                                <td>
                                    <div class="actions">
                                        <a class="bouton bouton--secondaire bouton--petit" href="{{ path('admin_client_edition', { id: client.id }) }}">Modifier</a>
                                        <form method="post" action="{{ path('admin_client_suppression', { id: client.id }) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('suppression' ~ client.id) }}">
                                            <button type="submit" class="bouton--danger bouton--petit" onclick="return confirm('Supprimer ce client ?')">Supprimer</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
{% endblock %}
