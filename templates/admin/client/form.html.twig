{% extends 'base.html.twig' %}

{% block title %}{{ client.id ? 'Modifier' : 'Nouveau' }} client — Comapik{% endblock %}

{% block body %}
    {% include 'admin/_nav.html.twig' %}

    <div class="page">
        <h1>{{ client.id ? 'Modifier' : 'Nouveau' }} client</h1>

        <div class="carte">
            {{ form_start(form) }}
                {{ form_row(form.nom) }}
                {{ form_row(form.codeAcces) }}

                <div class="champ">
                    <label>{{ form.evenements.vars.label }}</label>
                    <div class="checkbox-list">
                        {% for choix in form.evenements %}
                            <label>{{ form_widget(choix) }} {{ choix.vars.label }}</label>
                        {% else %}
                            <p class="vide">Aucun événement pour l'instant.</p>
                        {% endfor %}
                    </div>
                </div>

                <button type="submit" class="bouton--pleine-largeur">Enregistrer</button>
            {{ form_end(form) }}
        </div>

        <p><a class="bouton bouton--secondaire" href="{{ path('admin_clients') }}">← Retour à la liste</a></p>
    </div>
{% endblock %}
