{% extends 'base.html.twig' %}

{% block title %}Mes événements — Comapik{% endblock %}

{% block body %}
    {% include 'galerie/_nav.html.twig' %}

    <div class="page">
        <h1>Mes événements</h1>

        {% if evenements is empty %}
            <p class="etat-vide">Aucun événement n'est accessible avec ce code pour le moment.</p>
        {% else %}
            <ul class="liste-evenements">
                {% for evenement in evenements %}
                    <li>
                        <a href="{{ path('client_evenement_voir', { id: evenement.id }) }}">
                            <span>
                                <strong>{{ evenement.nom }}</strong>
                                <span class="date">{{ evenement.date|date('d/m/Y') }}</span>
                            </span>
                            <span class="chevron">›</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endblock %}
