{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
    <div class="page">
        <h1>Accéder à mes photos</h1>

        {% if erreur %}
            <p class="erreur">{{ erreur.messageKey|trans(erreur.messageData, 'security') }}</p>
        {% endif %}

        <form method="post" action="{{ path('client_connexion') }}">
            <div>
                <label for="code">Code d'accès</label>
                <input type="password" id="code" name="code" required autofocus autocomplete="off">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('client_connexion') }}">

            <button type="submit">Voir mes événements</button>
        </form>
    </div>
{% endblock %}
