{% extends 'base.html.twig' %}

{% block title %}{{ evenement.nom }} — Comapik{% endblock %}

{% block body %}
    {% include 'galerie/_nav.html.twig' %}

    <div class="page page--large">
        <p><a class="bouton bouton--secondaire bouton--petit" href="{{ path('client_mes_evenements') }}">← Mes événements</a></p>

        <div class="entete-section">
            <h1>{{ evenement.nom }}</h1>
        </div>
        <p class="sous-titre">
            {{ evenement.date|date('d/m/Y') }}
            {% if evenement.description %} · {{ evenement.description }}{% endif %}
        </p>

        {% if photos is empty %}
            <p class="etat-vide">Aucune photo n'a encore été ajoutée pour cet événement.</p>
        {% else %}
            <ul class="grille-photos">
                {% for photo in photos %}
                    <li>
                        <figure>
                            <button type="button" class="photo-vignette" data-visionneuse
                                    data-src="{{ path('client_photo_apercu', { id: photo.id }) }}"
                                    data-nom="{{ photo.nomOriginal }}"
                                    data-telechargement="{{ path('client_photo_telechargement', { id: photo.id }) }}">
                                <img src="{{ path('client_photo_miniature', { id: photo.id }) }}" alt="" loading="lazy">
                            </button>
                            <figcaption>
                                <a class="bouton bouton--petit bouton--pleine-largeur" href="{{ path('client_photo_telechargement', { id: photo.id }) }}">Télécharger</a>
                            </figcaption>
                        </figure>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>

    {% include '_visionneuse.html.twig' %}
{% endblock %}
