{% extends 'base.html.twig' %}

{% block title %}{{ evenement.nom }} — Comapik{% endblock %}

{% block body %}
    {% include 'galerie/_nav.html.twig' %}

    <div class="page page--large">
        <p><a class="bouton bouton--secondaire bouton--petit" href="{{ path('client_mes_evenements') }}">← Mes événements</a></p>

        <div class="entete-section">
            <h1>{{ evenement.nom }}</h1>
        </div>
        <p class="sous-titre">
            {{ evenement.date|date('d/m/Y') }}
            {% if evenement.description %} · {{ evenement.description }}{% endif %}
        </p>

        {% include '_flashes.html.twig' %}

        {% if evenement.uploadClientAutorise %}
            <div class="carte carte--accent">
                <h2>Ajouter vos photos</h2>
                <p class="help-text">Partagez vos photos de l'événement (JPEG ou PNG), depuis votre téléphone ou votre ordinateur.</p>
                <form method="post" action="{{ path('client_evenement_upload', { id: evenement.id }) }}" enctype="multipart/form-data" data-turbo="false" data-controller="redimensionnement" data-action="submit->redimensionnement#soumettre">
                    <div class="champ">
                        <label for="photos">Photos à ajouter</label>
                        <input type="file" id="photos" name="photos[]" accept="image/jpeg,image/png" multiple required data-redimensionnement-target="fichier">
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('upload') }}">
                    <button type="submit" class="bouton--pleine-largeur">Envoyer</button>
                </form>
            </div>
        {% endif %}

        {% if photosPhotographe is empty and photosClients is empty %}
            <p class="etat-vide">Aucune photo n'a encore été ajoutée pour cet événement.</p>
        {% else %}
            <form method="post" action="{{ path('client_photos_telechargement_groupe', { id: evenement.id }) }}" data-turbo="false">
                <p class="actions-selection">
                    <button type="submit" class="bouton bouton--secondaire bouton--petit">Télécharger la sélection</button>
                </p>

                {% if evenement.uploadClientAutorise or photosClients is not empty %}
                    <div class="onglets" role="tablist">
                        <button type="button" class="onglet" role="tab" aria-selected="{{ ongletActif == 'photographe' ? 'true' : 'false' }}" aria-controls="onglet-photographe" data-onglet="photographe">
                            Photographe ({{ photosPhotographe|length }})
                        </button>
                        <button type="button" class="onglet" role="tab" aria-selected="{{ ongletActif == 'invites' ? 'true' : 'false' }}" aria-controls="onglet-invites" data-onglet="invites">
                            Invités ({{ photosClients|length }})
                        </button>
                    </div>

                    <div id="onglet-photographe" class="onglet-panel" role="tabpanel" data-onglet-panel="photographe"{{ ongletActif != 'photographe' ? ' hidden' : '' }}>
                        {% include 'galerie/_grille_photos.html.twig' with {
                            photos: photosPhotographe,
                            vide: "Aucune photo du photographe pour l'instant.",
                        } %}
                    </div>

                    <div id="onglet-invites" class="onglet-panel" role="tabpanel" data-onglet-panel="invites"{{ ongletActif != 'invites' ? ' hidden' : '' }}>
                        {% include 'galerie/_grille_photos.html.twig' with {
                            photos: photosClients,
                            vide: "Aucune photo ajoutée par les invités pour l'instant.",
                        } %}
                    </div>
                {% else %}
                    {% include 'galerie/_grille_photos.html.twig' with {
                        photos: photosPhotographe,
                        vide: "Aucune photo du photographe pour l'instant.",
                    } %}
                {% endif %}
            </form>
        {% endif %}
    </div>

    {% include '_visionneuse.html.twig' %}
{% endblock %}
